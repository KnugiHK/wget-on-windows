{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GMP",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["GMP_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "gmp",
      "packageNameTemplate": "homebrew/gmp",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update Nettle",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["NETTLE_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "nettle",
      "packageNameTemplate": "homebrew/nettle",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update Libtasn1",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["TASN1_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "libtasn1",
      "packageNameTemplate": "homebrew/libtasn1",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update Libidn2",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["IDN2_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "libidn2",
      "packageNameTemplate": "homebrew/libidn2",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update Libunistring",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["UNISTRING_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "libunistring",
      "packageNameTemplate": "homebrew/libunistring",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update Libiconv",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["ICONV_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "libiconv",
      "packageNameTemplate": "homebrew/libiconv",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update Gettext",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["GETTEXT_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "gettext",
      "packageNameTemplate": "homebrew/gettext",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update Wget",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["WGET_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "wget",
      "packageNameTemplate": "homebrew/wget",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update zlib",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["ZLIB_VER=\"(?<currentValue>.*)\""],
      "depNameTemplate": "madler/zlib",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update c-ares",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["CARES_VER=\"(?<currentValue>.*)\""],
      "depNameTemplate": "c-ares/c-ares",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update libpsl",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["PSL_VER=\"(?<currentValue>.*)\""],
      "depNameTemplate": "rockdaboot/libpsl",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update PCRE2",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["PCRE2_VER=\"(?<currentValue>.*)\""],
      "depNameTemplate": "PCRE2Project/pcre2",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update OpenSSL",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["OPENSSL_VER=\"(?<currentValue>.*)\""],
      "depNameTemplate": "openssl/openssl",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update GPG error",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["GPG_ERROR_VER\\s*:=\\s*(?<currentValue>.*)\\n"],
      "depNameTemplate": "gpg/libgpg-error",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^libgpg-error-(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update GPG crypt",
      "managerFilePatterns": [
        "/^build.sh$/"
      ],
      "matchStrings": ["LIBGCRYPT_VER\\s*:=\\s*(?<currentValue>.*)\\n"],
      "depNameTemplate": "gpg/libgcrypt",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^libgcrypt-(?<version>.+)$"
    }
  ]
}
